{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zcsnqvncqzpleqoctzfc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "positivethots-app",
      "version": "0.1.0",
      "title": "PositiveThots.app"
    },
    "tools": [
      {
        "name": "list_courses",
        "title": "List courses",
        "description": "List the education courses (badge modules) available in Positive Thots, optionally filtered by tier.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "tier": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional tier filter, e.g. 'foundation' or 'advanced'. Null for all tiers."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max courses to return (default 50)."
            }
          },
          "required": [
            "tier",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_course",
        "title": "Get course",
        "description": "Get the full details and lesson content of a single Positive Thots education course by its slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "description": "The course slug, e.g. 'consent-basics'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "my_learning_progress",
        "title": "My learning progress",
        "description": "Get the signed-in user's Positive Thots learning progress: earned badges, learning level, and quiz scores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "my_connections",
        "title": "My connections",
        "description": "List the signed-in user's connections (people they and the other person both said yes to) in Positive Thots.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max connections to return (default 25)."
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_my_bio",
        "title": "Update my bio",
        "description": "Update the About Me text on the signed-in user's Positive Thots profile. Overwrites the existing bio.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "bio": {
              "type": "string",
              "description": "The new About Me text. Keep it warm, inclusive, and under 500 characters."
            }
          },
          "required": [
            "bio"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
